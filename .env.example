# Server Credentials (จำเป็นสำหรับการบันทึกข้อมูล Firestore)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SHOP_ID=
APP_ENV=production

# โหมดใช้งานคนเดียว (Single-User Mode): ไม่ต้องล็อกอิน เปิดเว็บเข้าใช้งานได้ทันที
# ค่าเริ่มต้น REQUIRE_AUTH ไม่ต้องตั้งค่า หรือตั้งเป็น false
REQUIRE_AUTH=false

# ตัวเลือกเสริม (Optional): กรณีต้องการจำกัดสิทธิ์ด้วย Google Sign-In ในอนาคต
# OWNER_UID=
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
