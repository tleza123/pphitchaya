# LINE Messaging API Configuration (Optional fallbacks for Firestore shops/{shopId}/profile/line)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DEFAULT_TARGET_ID=
LINE_ATTENDANCE_TARGET_ID=
LINE_TRUCK_TARGET_ID=
LINE_DAILY_SUMMARY_ENABLED=true

# Vercel Cron Secret (Optional, for authenticating /api/cron/daily-summary)
CRON_SECRET=
